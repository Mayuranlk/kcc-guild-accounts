rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function approved() {
      return signedIn() && userProfile().status == 'approved';
    }

    function treasurerOrAdmin() {
      return approved() && userProfile().role in ['treasurer', 'admin'];
    }

    function admin() {
      return approved() && userProfile().role == 'admin';
    }

    match /users/{userId} {
      allow create: if signedIn() && request.auth.uid == userId;
      allow read: if signedIn() && (request.auth.uid == userId || admin());
      allow update, delete: if admin();
    }

    match /staff/{staffId} {
      allow read: if approved();
      allow write: if treasurerOrAdmin();
    }

    match /events/{eventId} {
      allow read: if approved();
      allow write: if treasurerOrAdmin();
    }

    match /contributions/{contributionId} {
      allow read: if approved();
      allow write: if treasurerOrAdmin();
    }

    match /expenses/{expenseId} {
      allow read: if approved();
      allow write: if treasurerOrAdmin();
    }
  }
}
